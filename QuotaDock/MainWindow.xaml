<Window x:Class="QuotaDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QuotaDock.Controls"
        Title="QuotaDock"
        Width="244"
        Height="272"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ToolTipService.IsEnabled="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        DpiChanged="Window_DpiChanged"
        FontFamily="{StaticResource AppFont}"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#FF3A3A3C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="Transparent">
                            <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CatalogTemplate">
            <Border Height="36"
                    Background="Transparent"
                    CornerRadius="8"
                    Cursor="Hand"
                    MouseLeftButtonUp="CatalogItem_MouseLeftButtonUp">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <controls:BrandIcon Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Brand="{Binding Id}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FFF1F1F2"
                               Text="{Binding DisplayName}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF20E3A2"
                               Text="{Binding CheckText}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProviderTemplate">
            <Border Width="50"
                    Height="72"
                    Padding="0,8,0,0"
                    Background="Transparent"
                    Cursor="Hand"
                    RenderTransformOrigin="0.5,0.5"
                    Loaded="ProviderItem_Loaded"
                    MouseEnter="ProviderItem_MouseEnter"
                    MouseLeave="ProviderItem_MouseLeave"
                    PreviewMouseLeftButtonDown="ProviderItem_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ProviderItem_MouseLeftButtonUp"
                    LostMouseCapture="ProviderItem_LostMouseCapture">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <controls:UsageRing Width="32"
                                        Height="32"
                                        Percentage="{Binding SummaryPercent}"
                                        Accent="{Binding AccentBrush}"
                                        Brand="{Binding Id}"
                                        IsAvailable="{Binding IsReady}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFF5F5F7"
                               Text="{Binding SummaryText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WindowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="12"
                               FontWeight="Regular"
                               Foreground="#FFD1D1D6"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               FontSize="12"
                               FontWeight="Regular"
                               Foreground="#FF8E8E93"
                               Text="{Binding ResetText}" />
                </Grid>
                <ProgressBar Grid.Row="1"
                             Style="{StaticResource QuotaProgress}"
                             Foreground="{Binding BarBrush}"
                             Value="{Binding UsedPercent, Mode=OneWay}" />
                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           FontSize="13"
                           FontWeight="Regular"
                           Foreground="#FFF5F5F7"
                           Text="{Binding PercentText}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="Stage" Width="244" Height="272" Background="Transparent">
        <Border x:Name="EdgeHotZone"
                Width="12"
                Height="58"
                Canvas.Left="232"
                Canvas.Top="91"
                Background="#01000000"
                MouseEnter="EdgeHotZone_MouseEnter" />

        <Grid x:Name="DetailSurface"
              Width="194"
              Height="162"
              Canvas.Left="0"
              Canvas.Top="10"
              Opacity="0"
              Visibility="Hidden"
              MouseEnter="DetailSurface_MouseEnter"
              MouseLeave="DetailSurface_MouseLeave">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DetailScale" ScaleX="0.98" ScaleY="0.98" />
                    <TranslateTransform x:Name="DetailTranslate" X="10" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="DetailCard"
                    Width="176"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="16,14,16,14"
                    Background="#FF0A0A0B"
                    CornerRadius="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:BrandIcon Width="18"
                                            Height="18"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Brand="{Binding Id}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F7"
                                   Text="{Binding DisplayName}" />
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,10,0,0"
                                  ItemTemplate="{StaticResource WindowTemplate}"
                                  ItemsSource="{Binding Windows}"
                                  Visibility="{Binding ShowQuota, Converter={StaticResource BoolVis}}" />
                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowLogin, Converter={StaticResource BoolVis}}">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF5F5F7"
                                   Text="{Binding LoginTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#FFD1D1D6"
                                   TextWrapping="Wrap"
                                   Text="{Binding LoginHint}" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="#FF8E8E93"
                                   TextWrapping="Wrap"
                                   Text="{Binding LoginFooter}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Path x:Name="DetailPointer"
                  Width="10"
                  Height="16"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,22,8,0"
                  Data="M 0,0 L 10,8 L 0,16 Z"
                  Fill="#FF0A0A0B"
                  Stretch="Fill" />
        </Grid>

        <Grid x:Name="PickerSurface"
              Width="194"
              Height="220"
              Canvas.Left="0"
              Canvas.Top="10"
              Opacity="0"
              ClipToBounds="True"
              Visibility="Hidden">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PickerScale" ScaleX="0.98" ScaleY="0.98" />
                    <TranslateTransform x:Name="PickerTranslate" X="10" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border x:Name="PickerCard"
                    Width="176"
                    Height="220"
                    HorizontalAlignment="Left"
                    Padding="12,8,12,8"
                    Background="#FF0A0A0B"
                    CornerRadius="20">
                <StackPanel>
                    <Border Height="28"
                            Background="Transparent"
                            CornerRadius="8"
                            Cursor="Hand"
                            MouseLeftButtonUp="StartupItem_MouseLeftButtonUp">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="2"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#FFF1F1F2"
                                       Text="开机启动" />
                            <TextBlock x:Name="StartupCheckMark"
                                       Grid.Column="2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#FF20E3A2"
                                       Text="" />
                        </Grid>
                    </Border>
                    <Border Height="28"
                            Background="Transparent"
                            CornerRadius="8"
                            Cursor="Hand"
                            MouseLeftButtonUp="UpdateItem_MouseLeftButtonUp">
                        <Grid Margin="8,0">
                            <TextBlock x:Name="UpdateLabel"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#FFF1F1F2"
                                       Text="检查更新" />
                        </Grid>
                    </Border>
                    <Border Width="136"
                            Height="1"
                            Margin="0,2,0,6"
                            HorizontalAlignment="Center"
                            Background="#33FFFFFF" />
                    <ScrollViewer MaxHeight="144"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  PanningMode="VerticalOnly">
                        <ItemsControl ItemTemplate="{StaticResource CatalogTemplate}"
                                      ItemsSource="{Binding CatalogItems}" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Path x:Name="PickerPointer"
                  Width="10"
                  Height="16"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,18,8,0"
                  Data="M 0,0 L 10,8 L 0,16 Z"
                  Fill="#FF0A0A0B"
                  Stretch="Fill" />
        </Grid>

        <Canvas x:Name="Rail"
                Width="50"
                Height="272"
                Canvas.Left="194"
                Canvas.Top="0"
                Background="Transparent"
                RenderTransformOrigin="1,0.5"
                PreviewMouseRightButtonDown="Rail_PreviewMouseRightButtonDown">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RailScale" ScaleX="0.14" ScaleY="0.25" />
                    <TranslateTransform x:Name="RailTranslate" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Right-edge notch: straight screen edge, inner S of concave ear R=20 + convex stadium R=24. -->
            <Path x:Name="RailShape"
                  Width="50"
                  Height="272"
                  Fill="#FF050505"
                  Stretch="None"
                  Cursor="SizeAll"
                  RenderTransformOrigin="0.5,0.5"
                  Data="M 50,0 L 50,272 A 20,20 0 0 0 30,252 L 24,252 A 24,24 0 0 1 0,228 L 0,44 A 24,24 0 0 1 24,20 L 30,20 A 20,20 0 0 0 50,0 Z"
                  MouseLeftButtonDown="RailBackground_MouseLeftButtonDown"
                  MouseMove="RailBackground_MouseMove"
                  MouseLeftButtonUp="RailBackground_MouseLeftButtonUp"
                  LostMouseCapture="RailBackground_LostMouseCapture" />

            <Border x:Name="PlusHandle"
                    Width="32"
                    Height="32"
                    Canvas.Left="9"
                    Canvas.Top="28"
                    Opacity="0"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseEnter="PlusHandle_MouseEnter"
                    MouseLeave="PlusHandle_MouseLeave"
                    PreviewMouseLeftButtonDown="PlusHandle_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="PlusHandle_MouseLeftButtonUp">
                <Border x:Name="PlusBubble"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        CornerRadius="16"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PlusScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Path Width="12"
                          Height="12"
                          Stretch="Uniform"
                          Fill="#FFF2F2F3"
                          Data="F1 M5.1,0.6 L6.9,0.6 L6.9,5.1 L11.4,5.1 L11.4,6.9 L6.9,6.9 L6.9,11.4 L5.1,11.4 L5.1,6.9 L0.6,6.9 L0.6,5.1 L5.1,5.1 Z" />
                </Border>
            </Border>

            <ItemsControl x:Name="PipList"
                          Width="50"
                          Height="144"
                          Canvas.Left="0"
                          Canvas.Top="64"
                          IsHitTestVisible="False"
                          Opacity="1"
                          ItemsSource="{Binding Providers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="50" Height="72">
                            <Ellipse Width="16"
                                     Height="24"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding PipBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="ProviderList"
                          Width="50"
                          Height="144"
                          Canvas.Left="0"
                          Canvas.Top="64"
                          Opacity="0"
                          ItemTemplate="{StaticResource ProviderTemplate}"
                          ItemsSource="{Binding Providers}"
                          RenderTransformOrigin="0.5,0.5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.RenderTransform>
                    <ScaleTransform x:Name="ProviderListScale" ScaleX="0.94" ScaleY="0.94" />
                </ItemsControl.RenderTransform>
            </ItemsControl>

            <Border x:Name="DragHandle"
                    Width="32"
                    Height="32"
                    Canvas.Left="9"
                    Canvas.Top="212"
                    Opacity="0"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseEnter="ExitHandle_MouseEnter"
                    MouseLeave="ExitHandle_MouseLeave"
                    PreviewMouseLeftButtonDown="ExitHandle_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ExitHandle_MouseLeftButtonUp">
                <Border x:Name="GearBubble"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        CornerRadius="16"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GearScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Fill="#FFF2F2F3"
                              Data="F1 M1.35,0.15 L6,4.8 L10.65,0.15 L11.85,1.35 L7.2,6 L11.85,10.65 L10.65,11.85 L6,7.2 L1.35,11.85 L0.15,10.65 L4.8,6 L0.15,1.35 Z" />
                </Border>
            </Border>
        </Canvas>
    </Canvas>
</Window>
